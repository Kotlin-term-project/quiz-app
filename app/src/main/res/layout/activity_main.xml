<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="문제 목록"
        android:textColor="#000"
        android:textSize="35dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#aaa" />

    <Button
        android:id="@+id/add_folder_btn"
        android:background="@drawable/add_folder_background"
        android:drawableStart="@drawable/add_folder_shape"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_margin="10dp"
        android:paddingLeft="30dp"
        android:drawablePadding="20dp"
        android:gravity="start|center_vertical"
        android:text="폴더 추가하기"
        android:textSize="20sp"
        android:textColor="#1F2F98"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="폴더 목록" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/navigation_bar"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/main_btn"
            android:src="@drawable/nav_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:layout_weight="1"
            android:contentDescription="문제 목록" />

        <ImageButton
            android:id="@+id/take_test_btn"
            android:src="@drawable/nav_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:layout_weight="1"
            android:contentDescription="시험 치기"/>

        <ImageButton
            android:id="@+id/rate_btn"
            android:src="@drawable/nav_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:layout_weight="1"
            android:contentDescription="정답률" />

        <ImageButton
            android:id="@+id/timer_btn"
            android:src="@drawable/nav_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:layout_weight="1"
            android:contentDescription="타이머" />

    </LinearLayout>

<!--    <TextView-->
<!--        android:id="@+id/output"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_weight="1" />-->

</LinearLayout>







