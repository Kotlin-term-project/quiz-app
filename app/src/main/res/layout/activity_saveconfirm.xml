<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/spring2_shape" />

    <LinearLayout
        android:id="@+id/question_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/make_test_box"
        android:orientation="vertical"
        android:paddingTop="5dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/back_btn"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="수정"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:textColor="#7A7A7A"
                android:layout_gravity="center"
                android:layout_marginVertical="10dp" />

            <Button
                android:id="@+id/main_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="저장"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:textColor="#0C5183"
                android:layout_gravity="center"
                android:layout_marginVertical="10dp"
                android:layout_marginRight="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginRight="12dp"
            android:layout_marginLeft="12dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 문제 입력 컨테이너 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="문제"
                            android:textSize="22dp"
                            android:textColor="#000000"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/question_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/make_test_question_edittext_box"
                        android:gravity="start"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="8dp"
                        android:textSize="17dp"
                        android:textColor="@color/black"
                        android:minHeight="150dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="답변"
                            android:textSize="22dp"
                            android:textColor="#000000"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="7dp">
                        <TextView
                            android:id="@+id/choice1_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="7dp"
                            android:background="@drawable/make_test_answer_wrong_box" />
                        <Space android:layout_width="match_parent" android:layout_height="25dp"/>
                        <TextView
                            android:id="@+id/choice2_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="7dp"
                            android:background="@drawable/make_test_answer_wrong_box" />
                        <Space android:layout_width="match_parent" android:layout_height="25dp"/>
                        <TextView
                            android:id="@+id/choice3_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="7dp"
                            android:background="@drawable/make_test_answer_wrong_box" />
                        <Space android:layout_width="match_parent" android:layout_height="25dp"/>
                        <TextView
                            android:id="@+id/answer_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="7dp"
                            android:background="@drawable/make_test_answer_right_box" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>