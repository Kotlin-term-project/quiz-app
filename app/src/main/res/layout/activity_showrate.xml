<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:drawablePadding="10dp"
        android:text="정답률"
        android:textStyle="bold"
        android:textColor="#000"
        android:textSize="38dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <View
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:background="#AFAFAF"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/select_folder_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="60dp"
        android:layout_marginTop="10dp"
        android:drawableEnd="@drawable/toggle_shape2"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:text="전체(0)"
        android:textSize="17dp"
        android:textColor="#777777"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line" />

    <ProgressBar
        android:id="@+id/rate_circle"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/show_rate_circle_outer"
        android:indeterminate="false"
        android:progressDrawable="@drawable/show_rate_circle_inner"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/select_folder_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 정답 -->
    <LinearLayout
        android:id="@+id/text_group_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/rate_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/blue_point"
            android:drawablePadding="15dp"
            android:paddingRight="5dp"
            android:text="정답"
            android:textSize="25dp"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/correct_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:text="NN개 (0%)"
            android:textSize="25dp"
            android:textColor="#0075E9" />
    </LinearLayout>

    <!-- 오답 -->
    <LinearLayout
        android:id="@+id/text_group_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/text_group_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/grey_point"
            android:drawablePadding="15dp"
            android:paddingRight="5dp"
            android:text="오답"
            android:textSize="25dp"
            android:textColor="#000" />

        <TextView
            android:id="@+id/wrong_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:text="NN개 (0%)"
            android:textSize="25dp"
            android:textColor="#B6B6B6" />
    </LinearLayout>

    <!-- 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/navigation_bar"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/main_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/nav_main"
            android:drawablePadding="13dp"
            android:paddingVertical="15dp"
            android:text="문제 목록"
            android:textColor="#000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/take_test_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/nav_test"
            android:drawablePadding="10dp"
            android:paddingVertical="15dp"
            android:text="시험 치기"
            android:textColor="#000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/rate_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/nav_rate"
            android:drawablePadding="6dp"
            android:paddingVertical="15dp"
            android:text="정답률"
            android:textColor="#000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/timer_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/nav_timer"
            android:drawablePadding="6dp"
            android:paddingVertical="15dp"
            android:text="타이머"
            android:textColor="#000"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
